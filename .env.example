# =============================================================================
# Banco de dados (PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_pedido?schema=public"

# =============================================================================
# Auth.js (NextAuth)
# Gere um segredo com: npx auth secret   (ou)   openssl rand -base64 32
# =============================================================================
AUTH_SECRET="troque-por-um-segredo-aleatorio-forte"
# URL pública da aplicação (necessária em produção)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Stripe (pagamento com cartão). Opcional: o método "Dinheiro na entrega"
# funciona sem nenhuma chave. Para testar cartão, use as chaves de teste.
# =============================================================================
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Segredo do webhook (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=""
